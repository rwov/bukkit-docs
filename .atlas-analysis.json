  "keyFeatures": [
    "Plugin lifecycle management with onEnable/onDisable/onLoad hooks",
    "Rich event system with prioritized, cancellable event handling",
    "Command registration and tab-completion framework",
    "Hierarchical permissions system with OP/non-OP defaults",
    "YAML-based configuration with hot-reload support",
    "Sync and async task scheduling via BukkitScheduler",
    "Full world, block, and entity manipulation API",
    "Inventory and item meta management",
    "Player profile and UUID-based player management",
    "Plugin messaging channels for cross-server communication",
    "Scoreboard and boss-bar APIs",
    "Custom world generator API"
  ],
  "publicApiSurface": [
    "JavaPlugin (abstract base class for all plugins)",
    "Plugin interface (onEnable, onDisable, onLoad, getConfig, getServer)",
    "Server interface (getOnlinePlayers, getWorld, getScheduler, getPluginManager)",
    "Listener interface + @EventHandler annotation",
    "CommandExecutor#onCommand + TabCompleter#onTabComplete",
    "BukkitScheduler (runTask, runTaskLater, runTaskTimer, runTaskAsynchronously)",
    "FileConfiguration / YamlConfiguration (get, set, save, reload)",
    "Permission / PermissionDefault",
    "PluginDescriptionFile (plugin.yml runtime container)",
    "PluginManager (registerEvents, registerCommand, callEvent)",
    "World / Block / BlockData API",
    "Entity / LivingEntity / Player API",
    "Inventory / ItemStack / ItemMeta API",
    "BossBar API",
    "Scoreboard / Team / Objective API",
    "BukkitRunnable (chainable task helper)",
    "ServicesManager (registerService, getRegistration)",
    "Messenger / PluginMessageListener (plugin channels)"
  ]
}
